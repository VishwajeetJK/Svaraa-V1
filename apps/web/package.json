{
  "name": "@svaraa/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:pages": "tsc -p tsconfig.json --noEmit && VITE_STATIC_DEMO=true vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "preview:pages": "VITE_STATIC_DEMO=true vite preview",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@svaraa/shared": "workspace:*",
    "@svaraa/ui": "workspace:*",
    "@svaraa/walkthrough-kb": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
