{
  "name": "svaraa-lite",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:up": "docker compose up -d postgres redis minio || echo 'Docker unavailable — apps use PGlite fallback'",
    "dev:web": "pnpm --filter @svaraa/web dev",
    "dev:cp": "pnpm --filter @svaraa/control-plane dev",
    "dev:tenant": "pnpm --filter @svaraa/tenant dev",
    "dev:gateway": "pnpm --filter @svaraa/gateway start",
    "gates": "tsx scripts/release-gates.ts",
    "demo": "node scripts/dev-all.mjs",
    "demo:seed": "node scripts/demo.mjs",
    "pages:build": "pnpm --filter @svaraa/web build:pages"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "wait-on": "^8.0.1"
  }
}
